{
  "key": "trends",
  "supplier_id": 3,
  "source": "Trends distributor product pages (trends.com.au, Pricing tab, Additional Costs down to Shipping and Handling), all 2,443 Trends products on the range read 3 Nov 2026. Prices stay Promodata's (SaaS pricing); this file only says how the lines combine.",
  "groups": {
    "clip": {
      "label": "Clip",
      "pick": "one",
      "order": 10,
      "note": "Standard: single metal clip and safety clip."
    },
    "attach": {
      "label": "Add attachments",
      "pick": "many",
      "order": 11
    },
    "stitches": {
      "label": "Embroidery extras",
      "pick": "many",
      "order": 20,
      "with_method": [
        "embroidery"
      ],
      "base_stitches": 10000,
      "note": "Embroidery is priced up to 10,000 stitches; bigger designs add blocks of 5,000."
    },
    "personalise": {
      "label": "Personalise each item",
      "pick": "count",
      "order": 30,
      "max": 3,
      "unit_label": "line",
      "note": "A different name or line of text on each item. Send the list with your artwork.",
      "with_method": [
        "laser",
        "digital",
        "label",
        "doming",
        "pad",
        "screen",
        "dtf",
        "sublimation"
      ]
    },
    "packaging": {
      "label": "Packaging",
      "pick": "one",
      "optional": true,
      "order": 40
    },
    "data": {
      "label": "Data upload",
      "pick": "many",
      "order": 45,
      "note": "Your files loaded onto every drive."
    },
    "extras": {
      "label": "Extras",
      "pick": "many",
      "order": 50
    },
    "base": {
      "label": "Base",
      "pick": "one",
      "optional": true,
      "order": 51
    },
    "service": {
      "label": "Before production",
      "pick": "many",
      "order": 60
    }
  },
  "lines": [
    {
      "match": "^metalclip$",
      "group": "clip",
      "name": "Single metal clip",
      "included": true
    },
    {
      "match": "^doubleclip",
      "group": "clip",
      "name": "Double clip"
    },
    {
      "match": "^jhookclip",
      "group": "clip",
      "name": "J hook clip"
    },
    {
      "match": "^loopclip",
      "group": "clip",
      "name": "Loop clip"
    },
    {
      "match": "^ovalclip",
      "group": "clip",
      "name": "Oval clip"
    },
    {
      "match": "^springclip",
      "group": "clip",
      "name": "Spring clip"
    },
    {
      "match": "^safetyclip",
      "group": "attach",
      "name": "Safety clip",
      "included": true,
      "fixed": true
    },
    {
      "match": "^loopattachment",
      "group": "attach",
      "name": "Phone loop"
    },
    {
      "match": "^snaplockjoiner",
      "group": "attach",
      "name": "Snap lock joiner"
    },
    {
      "match": "^idholder",
      "group": "attach",
      "name": "ID holder",
      "excludes": [
        "duetidholder"
      ]
    },
    {
      "match": "^duetidholder",
      "group": "attach",
      "name": "Duet ID holder",
      "excludes": [
        "idholder"
      ]
    },
    {
      "match": "^shoelaceattachment",
      "group": "attach",
      "name": "Shoelace attachment"
    },
    {
      "match": "^embroideryperadditional\\d+stitches",
      "group": "stitches",
      "name": "Extra 5,000 stitches",
      "count": {
        "max": 4,
        "label": "× 5,000 stitches"
      }
    },
    {
      "match": "^metallicthread",
      "group": "stitches",
      "name": "Metallic thread",
      "per_stitches": 1000
    },
    {
      "match": "^threadchangeoutfee",
      "group": "stitches",
      "name": "Thread colour change",
      "per": "order"
    },
    {
      "match": "^classicthreadsurcharge",
      "group": "stitches",
      "name": "Classic thread colours",
      "per": "order"
    },
    {
      "match": "^personalisationsurcharge",
      "group": "personalise",
      "name": "Personalisation"
    },
    {
      "match": "^giftboxsleeve|^packagingsleeve",
      "group": "packaging",
      "name": "Printed gift box sleeve"
    },
    {
      "match": "^magneticclosuregiftbox",
      "group": "packaging",
      "name": "Magnetic gift box"
    },
    {
