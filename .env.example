APP_NAME="CMAU SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Australia/Melbourne

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: MariaDB 10.11 on cPanel account saasreplicat584 (utf8mb4).
# See docs/deploy.md for the full production .env. Local dev and tests use SQLite.
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=saasreplicat584_saas
# DB_USERNAME=saasreplicat584_app
# DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="saas@crowdmerch.com.au"
MAIL_FROM_NAME="${APP_NAME}"

# Promodata (supplier product data). The token is entered on the server only.
PROMODATA_BASE_URL=https://api.promodata.com.au
PROMODATA_TOKEN=
PROMODATA_TIMEOUT=60
PROMODATA_PAGES_PER_STEP=5

# Catalogue tiers: unused Active products drop to Summary after this many months.
CATALOGUE_ACTIVE_WINDOW_MONTHS=12

# Shopify (CMAUDEV first; the live store token is added only at go-live).
# Writes (draft orders from the website quote API) are refused unless
# SHOPIFY_SHOP_DOMAIN equals SHOPIFY_DEV_STORE, or SHOPIFY_ALLOW_LIVE=true.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_DEV_STORE=
SHOPIFY_ALLOW_LIVE=false
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_PULL_DRAFTS=true

# Website quote API (Quick Quote and wish lists from the CMAU theme).
# Comma-separated store origins allowed to call it, e.g. the CMAUDEV store's address.
WEBSITE_QUOTE_API=true
WEBSITE_QUOTE_ORIGINS=
WEBSITE_QUOTES_PER_HOUR=10
WEBSITE_WISHLIST_PER_HOUR=60
WEBSITE_EMAIL_INSTANT_QUOTE=true

# Stock relay for the CMAU product page (/stock.php?id=...).
STOCK_RELAY_ORIGINS=https://crowdmerch.com.au,https://www.crowdmerch.com.au

# Quotes continue TOD's numbering.
QUOTE_NUMBER_START=11775

# One-time token for /setup (creates the first admin). Remove after use.
SETUP_TOKEN=

# Office static IP(s), comma separated, for admin-only screens.
ADMIN_ALLOWED_IPS=

VITE_APP_NAME="${APP_NAME}"

# Step 1 website search (docs/website-search.md). Secrets go in the server .env only.
WEBSITE_SEARCH=true
WEBSITE_SEARCH_ORIGINS=
WEBSITE_SEARCH_PER_MINUTE=10
WEBSITE_SEARCH_AI_PER_HOUR=5
WEBSITE_SEARCH_AI_PER_DAY=300
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
TURNSTILE_PROTECT_WEBSITE_API=false
ANTHROPIC_API_KEY=
ANTHROPIC_SEARCH_MODEL=claude-haiku-5-5
