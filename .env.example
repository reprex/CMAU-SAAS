APP_NAME="CMAU SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Australia/Melbourne

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production: MariaDB 10.11 on the cPanel account (database cmausaas, utf8mb4).
# Local development and tests use SQLite.
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=appcrowdmerch746_cmausaas
# DB_USERNAME=appcrowdmerch746_cmausaas
# DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="saas@crowdmerch.com.au"
MAIL_FROM_NAME="${APP_NAME}"

# Promodata (supplier product data). The token is entered on the server only.
PROMODATA_BASE_URL=https://api.promodata.com.au
PROMODATA_TOKEN=
PROMODATA_TIMEOUT=60
PROMODATA_PAGES_PER_STEP=5

# Catalogue tiers: unused Active products drop to Summary after this many months.
CATALOGUE_ACTIVE_WINDOW_MONTHS=12

# Shopify (CMAUDEV first; the live store token is added only at go-live).
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=
SHOPIFY_WEBHOOK_SECRET=

# Office static IP(s), comma separated, for admin-only screens.
ADMIN_ALLOWED_IPS=

VITE_APP_NAME="${APP_NAME}"
